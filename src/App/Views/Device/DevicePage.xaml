<Page x:Class="ReportMate.App.Views.Device.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky header: device row + tab strip, on the header surface. -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid Height="64" Margin="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceNameText" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" />
                        <ui:FontIcon Glyph="&#xE770;" FontSize="14" Margin="8,0,12,0" Opacity="0.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="Windows" />
                        <StackPanel x:Name="PillsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing x:Name="LoadingRing" IsActive="False" Width="18" Height="18" Margin="0,0,10,0" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Click="OnRunClicked" ToolTip="Run a new collection" Margin="0,0,6,0" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE768;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Collect" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRefreshClicked" ToolTip="Reload the report from the local cache" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <ui:DropDownButton Margin="6,0,0,0" Padding="8,5" ToolTip="More actions">
                            <ui:FontIcon Glyph="&#xE712;" FontSize="14" />
                            <ui:DropDownButton.Flyout>
                                <ui:MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Copy serial number" Click="OnCopySerial" />
                                    <MenuItem Header="Copy asset tag" Click="OnCopyAssetTag" />
                                    <MenuItem Header="Copy IP address" Click="OnCopyIp" />
                                    <Separator />
                                    <MenuItem Header="Open cache folder" Click="OnOpenCache" />
                                    <MenuItem Header="Open in ReportMate web" Click="OnOpenWeb" />
                                </ui:MenuFlyout>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </StackPanel>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="24,0,24,0">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ContentScroller">
            <Grid Margin="24,20,24,32">
                <ContentControl x:Name="TabHost" HorizontalContentAlignment="Stretch" />
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="480" Margin="0,80,0,0">
                    <ui:FontIcon Glyph="&#xE7F8;" FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No device report yet" Style="{StaticResource PageTitleTextStyle}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock x:Name="EmptyDetail" Style="{StaticResource SubtitleTextStyle}" TextAlignment="Center"
                               Text="Run a collection to build this device's report from the local cache." />
                    <Button Content="Run collection" Click="OnRunClicked" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="16,7" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
