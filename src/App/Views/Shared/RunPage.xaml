<Page x:Class="ReportMate.App.Views.Shared.RunPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Control bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Grid.Column="0" Click="RunButton_Click" VerticalAlignment="Center" Padding="14,7"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon x:Name="RunIcon" Glyph="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock x:Name="RunText" Text="Run Managed Reports Runner" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="DebugToggle" Content="Debug" Checked="DebugToggle_Changed" Unchecked="DebugToggle_Changed" />
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" Visibility="Collapsed" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing x:Name="RunningProgress" IsActive="False" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock x:Name="RunningLabel" Text="Running..." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <ui:FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Module selector -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE74C;" FontSize="15" Foreground="{DynamicResource IconBlueForeground}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Modules" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ModuleSummaryLabel" Text="All modules" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Select All" Click="SelectAll_Click" Padding="8,3" />
                        <Button Content="Deselect All" Click="DeselectAll_Click" Padding="8,3" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="ModuleList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <ui:ProgressBar x:Name="StepProgress" IsIndeterminate="True" />
            <Grid Margin="0,4,0,0">
                <TextBlock x:Name="StepItemLabel" Text="Initializing..." Style="{StaticResource CaptionTextStyle}" />
                <TextBlock x:Name="StepCountLabel" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- Result banner -->
        <Border x:Name="ResultBanner" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0" CornerRadius="8" Padding="12,10"
                BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:FontIcon x:Name="ResultIcon" Glyph="&#xE73E;" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ResultMessage" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Console -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="4">
            <RichTextBox x:Name="ConsoleOutput" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Foreground="{DynamicResource TextPrimaryBrush}" IsDocumentEnabled="True">
                <FlowDocument x:Name="ConsoleDocument" PagePadding="8" LineHeight="17" />
            </RichTextBox>
        </Border>
    </Grid>
</Page>
