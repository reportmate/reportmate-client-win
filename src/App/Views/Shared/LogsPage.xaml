<Page x:Class="ReportMate.App.Views.Shared.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="16,12">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE9D5;" FontSize="15" Foreground="{DynamicResource IconBlueForeground}" Margin="0,0,8,0" />
                        <TextBlock Text="Log Sessions" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LogCountLabel" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <ListView x:Name="LogListView" Grid.Row="1" SelectionChanged="LogListView_SelectionChanged"
                          BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,4">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ModifiedLabel}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionTextStyle}" Margin="8,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Button ToolTip="Open in Notepad" Click="OpenInEditor_Click" Padding="8,5"><ui:FontIcon Glyph="&#xE70F;" FontSize="13" /></Button>
                        <Button ToolTip="Open log folder" Click="OpenFolder_Click" Padding="8,5" Margin="4,0,0,0"><ui:FontIcon Glyph="&#xE838;" FontSize="13" /></Button>
                        <Button ToolTip="Refresh" Click="Refresh_Click" Padding="8,5" Margin="4,0,0,0"><ui:FontIcon Glyph="&#xE72C;" FontSize="13" /></Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="FilterBox" Grid.Row="0" ui:ControlHelper.PlaceholderText="Filter log lines..." TextChanged="FilterBox_TextChanged" />
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="4">
                <Grid>
                    <RichTextBox x:Name="LogContent" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Foreground="{DynamicResource TextPrimaryBrush}">
                        <FlowDocument x:Name="LogDocument" PagePadding="8" LineHeight="17" />
                    </RichTextBox>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:FontIcon Glyph="&#xE9D5;" FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No log files found" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="Run a collection to generate log output." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
