<Application x:Class="ReportMate.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:cvt="clr-namespace:ReportMate.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Layered surfaces matching the web app's gray-50 / white (light) and
                     black / gray-900 / gray-800 (dark) palette. The custom brushes must sit
                     inside ThemeResources' own dictionaries to be theme-resolved. -->
                <ui:ThemeResources>
                    <ui:ThemeResources.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB" />
                            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
                            <SolidColorBrush x:Key="SubtleFillBrush" Color="#F3F4F6" />
                            <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#E5E7EB" />
                            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
                            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
                            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9CA3AF" />
                            <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />
                            <SolidColorBrush x:Key="PillGrayBackground" Color="#F3F4F6" />
                            <SolidColorBrush x:Key="PillGrayForeground" Color="#1F2937" />
                            <SolidColorBrush x:Key="PillGreenBackground" Color="#DCFCE7" />
                            <SolidColorBrush x:Key="PillGreenForeground" Color="#166534" />
                            <SolidColorBrush x:Key="PillYellowBackground" Color="#FEF9C3" />
                            <SolidColorBrush x:Key="PillYellowForeground" Color="#854D0E" />
                            <SolidColorBrush x:Key="PillRedBackground" Color="#FEE2E2" />
                            <SolidColorBrush x:Key="PillRedForeground" Color="#991B1B" />
                            <SolidColorBrush x:Key="PillBlueBackground" Color="#DBEAFE" />
                            <SolidColorBrush x:Key="PillBlueForeground" Color="#1E40AF" />
                            <SolidColorBrush x:Key="PillPurpleBackground" Color="#F3E8FF" />
                            <SolidColorBrush x:Key="PillPurpleForeground" Color="#6B21A8" />
                            <SolidColorBrush x:Key="PillOrangeBackground" Color="#FFEDD5" />
                            <SolidColorBrush x:Key="PillOrangeForeground" Color="#9A3412" />
                            <SolidColorBrush x:Key="IconBlueBackground" Color="#DBEAFE" />
                            <SolidColorBrush x:Key="IconBlueForeground" Color="#2563EB" />
                            <SolidColorBrush x:Key="IconOrangeBackground" Color="#FFEDD5" />
                            <SolidColorBrush x:Key="IconOrangeForeground" Color="#EA580C" />
                            <SolidColorBrush x:Key="IconRedBackground" Color="#FEE2E2" />
                            <SolidColorBrush x:Key="IconRedForeground" Color="#DC2626" />
                            <SolidColorBrush x:Key="IconGreenBackground" Color="#DCFCE7" />
                            <SolidColorBrush x:Key="IconGreenForeground" Color="#16A34A" />
                            <SolidColorBrush x:Key="IconPurpleBackground" Color="#F3E8FF" />
                            <SolidColorBrush x:Key="IconPurpleForeground" Color="#9333EA" />
                            <SolidColorBrush x:Key="IconIndigoBackground" Color="#E0E7FF" />
                            <SolidColorBrush x:Key="IconIndigoForeground" Color="#4F46E5" />
                            <SolidColorBrush x:Key="IconYellowBackground" Color="#FEF08A" />
                            <SolidColorBrush x:Key="IconYellowForeground" Color="#A16207" />
                            <SolidColorBrush x:Key="IconTealBackground" Color="#CCFBF1" />
                            <SolidColorBrush x:Key="IconTealForeground" Color="#0D9488" />
                            <SolidColorBrush x:Key="IconCyanBackground" Color="#CFFAFE" />
                            <SolidColorBrush x:Key="IconCyanForeground" Color="#0891B2" />
                            <SolidColorBrush x:Key="IconEmeraldBackground" Color="#D1FAE5" />
                            <SolidColorBrush x:Key="IconEmeraldForeground" Color="#059669" />
                            <SolidColorBrush x:Key="IconPinkBackground" Color="#FCE7F3" />
                            <SolidColorBrush x:Key="IconPinkForeground" Color="#DB2777" />
                            <SolidColorBrush x:Key="IconGrayBackground" Color="#F3F4F6" />
                            <SolidColorBrush x:Key="IconGrayForeground" Color="#4B5563" />
                            <SolidColorBrush x:Key="IconMonoBackground" Color="#F3F4F6" />
                            <SolidColorBrush x:Key="IconMonoForeground" Color="#111827" />
                            <SolidColorBrush x:Key="StatusGreenBrush" Color="#15803D" />
                            <SolidColorBrush x:Key="StatusYellowBrush" Color="#A16207" />
                            <SolidColorBrush x:Key="StatusOrangeBrush" Color="#EA580C" />
                            <SolidColorBrush x:Key="StatusRedBrush" Color="#B91C1C" />
                            <SolidColorBrush x:Key="StatusBlueBrush" Color="#1D4ED8" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0C" />
                            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#111827" />
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F2937" />
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#374151" />
                            <SolidColorBrush x:Key="SubtleFillBrush" Color="#374151" />
                            <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#4B5563" />
                            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB" />
                            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
                            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7280" />
                            <SolidColorBrush x:Key="DividerBrush" Color="#374151" />
                            <SolidColorBrush x:Key="PillGrayBackground" Color="#374151" />
                            <SolidColorBrush x:Key="PillGrayForeground" Color="#E5E7EB" />
                            <SolidColorBrush x:Key="PillGreenBackground" Color="#14532D" />
                            <SolidColorBrush x:Key="PillGreenForeground" Color="#BBF7D0" />
                            <SolidColorBrush x:Key="PillYellowBackground" Color="#713F12" />
                            <SolidColorBrush x:Key="PillYellowForeground" Color="#FEF08A" />
                            <SolidColorBrush x:Key="PillRedBackground" Color="#7F1D1D" />
                            <SolidColorBrush x:Key="PillRedForeground" Color="#FECACA" />
                            <SolidColorBrush x:Key="PillBlueBackground" Color="#1E3A8A" />
                            <SolidColorBrush x:Key="PillBlueForeground" Color="#BFDBFE" />
                            <SolidColorBrush x:Key="PillPurpleBackground" Color="#581C87" />
                            <SolidColorBrush x:Key="PillPurpleForeground" Color="#E9D5FF" />
                            <SolidColorBrush x:Key="PillOrangeBackground" Color="#7C2D12" />
                            <SolidColorBrush x:Key="PillOrangeForeground" Color="#FED7AA" />
                            <SolidColorBrush x:Key="IconBlueBackground" Color="#1E3A8A" />
                            <SolidColorBrush x:Key="IconBlueForeground" Color="#60A5FA" />
                            <SolidColorBrush x:Key="IconOrangeBackground" Color="#7C2D12" />
                            <SolidColorBrush x:Key="IconOrangeForeground" Color="#FB923C" />
                            <SolidColorBrush x:Key="IconRedBackground" Color="#7F1D1D" />
                            <SolidColorBrush x:Key="IconRedForeground" Color="#F87171" />
                            <SolidColorBrush x:Key="IconGreenBackground" Color="#14532D" />
                            <SolidColorBrush x:Key="IconGreenForeground" Color="#4ADE80" />
                            <SolidColorBrush x:Key="IconPurpleBackground" Color="#581C87" />
                            <SolidColorBrush x:Key="IconPurpleForeground" Color="#C084FC" />
                            <SolidColorBrush x:Key="IconIndigoBackground" Color="#312E81" />
                            <SolidColorBrush x:Key="IconIndigoForeground" Color="#818CF8" />
                            <SolidColorBrush x:Key="IconYellowBackground" Color="#854D0E" />
                            <SolidColorBrush x:Key="IconYellowForeground" Color="#FDE047" />
                            <SolidColorBrush x:Key="IconTealBackground" Color="#134E4A" />
                            <SolidColorBrush x:Key="IconTealForeground" Color="#2DD4BF" />
                            <SolidColorBrush x:Key="IconCyanBackground" Color="#164E63" />
                            <SolidColorBrush x:Key="IconCyanForeground" Color="#22D3EE" />
                            <SolidColorBrush x:Key="IconEmeraldBackground" Color="#064E3B" />
                            <SolidColorBrush x:Key="IconEmeraldForeground" Color="#34D399" />
                            <SolidColorBrush x:Key="IconPinkBackground" Color="#831843" />
                            <SolidColorBrush x:Key="IconPinkForeground" Color="#F472B6" />
                            <SolidColorBrush x:Key="IconGrayBackground" Color="#374151" />
                            <SolidColorBrush x:Key="IconGrayForeground" Color="#9CA3AF" />
                            <SolidColorBrush x:Key="IconMonoBackground" Color="#374151" />
                            <SolidColorBrush x:Key="IconMonoForeground" Color="#F9FAFB" />
                            <SolidColorBrush x:Key="StatusGreenBrush" Color="#4ADE80" />
                            <SolidColorBrush x:Key="StatusYellowBrush" Color="#FDE047" />
                            <SolidColorBrush x:Key="StatusOrangeBrush" Color="#FB923C" />
                            <SolidColorBrush x:Key="StatusRedBrush" Color="#F87171" />
                            <SolidColorBrush x:Key="StatusBlueBrush" Color="#60A5FA" />
                        </ResourceDictionary>
                    </ui:ThemeResources.ThemeDictionaries>
                </ui:ThemeResources>
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <cvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <cvt:BoolToVisibilityConverter x:Key="InvertBoolToVisibility" Invert="True" />
            <cvt:InvertBoolConverter x:Key="InvertBool" />
            <cvt:StringToVisibilityConverter x:Key="StringToVisibility" />
            <cvt:CountToVisibilityConverter x:Key="CountToVisibility" />

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- Surfaces -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Typography -->
            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="StatLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="StatValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="MonoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>
            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            </Style>

            <!-- Pills -->
            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Background" Value="{DynamicResource PillGrayBackground}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource PillGrayForeground}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Segmented top navigation -->
            <Style x:Key="NavigationTabStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Device page tab strip: icon + label, accent underline when selected -->
            <Style x:Key="DeviceTabStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                        CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Underline" Grid.Row="1" Background="Transparent" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Underline" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource StatusBlueBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid restated in theme brushes; stock WPF paints white regardless of theme. -->
            <Style x:Key="GridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            </Style>
            <Style x:Key="GridCellStyle" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="12,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style x:Key="GridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="RowHeight" Value="34" />
                <Setter Property="ColumnHeaderHeight" Value="34" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="AlternatingRowBackground" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridColumnHeaderStyle}" />
                <Setter Property="CellStyle" Value="{StaticResource GridCellStyle}" />
                <Setter Property="RowStyle" Value="{StaticResource GridRowStyle}" />
            </Style>

            <Style x:Key="FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
